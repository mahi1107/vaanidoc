# ============================================================================
# VaaniDoc Environment Configuration Template
# Copy this file to .env and fill in your environment-specific values.
# ============================================================================

APP_NAME=VaaniDoc
APP_ENV=development
DEBUG=True
TIMEZONE=Asia/Kolkata
PORT=8000
CORS_ORIGINS=*

# ----------------------------------------------------------------------------
# 1. Database Configuration
# ----------------------------------------------------------------------------
# For Local Dev (SQLite default):
DATABASE_URL=sqlite:///./vaanidoc.db

# For Production (PostgreSQL):
# DATABASE_URL=postgresql://user:password@localhost:5432/vaanidoc_db

# ----------------------------------------------------------------------------
# 2. Authentication & Security
# ----------------------------------------------------------------------------
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here

# ----------------------------------------------------------------------------
# 3. AI Pipeline Providers
# ----------------------------------------------------------------------------
# Options: 'indic' (gTTS + Indic Wav2Vec + IndicBERT), 'mock'
ASR_PROVIDER=indic
NLP_PROVIDER=indic
TTS_PROVIDER=indic
ASR_CONFIDENCE_THRESHOLD=0.60
TRIAGE_UNCERTAINTY_THRESHOLD=0.50

# Cloud AI API Keys (Optional hosted inference overrides)
HUGGINGFACE_API_KEY=
OPENAI_API_KEY=
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# ----------------------------------------------------------------------------
# 4. Telephony & Messaging Gateways (Optional)
# ----------------------------------------------------------------------------
# Options: 'mock', 'exotel', 'twilio'
IVR_PROVIDER=mock
SMS_PROVIDER=mock

# Exotel (Indian Telecom Gateway)
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_PHONE_NUMBER=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_WEBHOOK_SECRET=

# Twilio (Global Voice & SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# 5. Emergency Helplines
# ----------------------------------------------------------------------------
EMERGENCY_PHONE_NUMBER=108
AMBULANCE_PHONE_NUMBER=102
ASHA_HELP_DESK_NUMBER=104

# ----------------------------------------------------------------------------
# 6. Privacy & Audio Retention Policy
# ----------------------------------------------------------------------------
AUDIO_RETENTION_DAYS=7
ENABLE_AUDIO_STORAGE=False
ANONYMIZE_ANALYTICS=True
