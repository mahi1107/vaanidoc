# ==============================================================================
# Git Ignore Configuration for VaaniDoc
# ==============================================================================

# Environment files (NEVER commit real secrets)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.eggs/

# SQLite & local databases
*.db
*.sqlite
*.sqlite3
vaanidoc.db

# Virtual environments
venv/
env/
.venv/
ENV/

# Node & Frontend build artifacts
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
.npm
.eslintcache

# Logs & temporary files
*.log
logs/
*.tmp
*.temp
.DS_Store
Thumbs.db

# IDE & Editors
.vscode/
.idea/
*.swp
*.swo
*~
